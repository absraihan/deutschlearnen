{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_NAME": "DeutschLearnen",
        "EXPO_PUBLIC_API_URL": "https://deutschlearnen-server.onrender.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_NAME": "DeutschLearnen",
        "EXPO_PUBLIC_API_URL": "https://deutschlearnen-server.onrender.com"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_NAME": "DeutschLearnen",
        "EXPO_PUBLIC_API_URL": "https://deutschlearnen-server.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  },
  "//": "EXPO_PUBLIC_API_TOKEN is deliberately absent: this file is committed. Set it with `eas secret:create` for cloud builds, or in apps/mobile/.env (gitignored) for local builds."
}
