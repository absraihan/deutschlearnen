# Applied to android/gradle.properties after `expo prebuild`, which regenerates
# that file. Kept here so the settings are versioned and reviewable.
#
# reactNativeArchitectures: arm64-v8a alone cuts the APK from ~108 MB to ~40 MB.
# Every Android phone shipped since roughly 2018 is arm64. Add armeabi-v7a back
# if the APK has to install on an older 32-bit device.
#
# The memory settings exist because this machine has 7 GB RAM and Gradle's
# defaults get the daemon OOM-killed.
reactNativeArchitectures=arm64-v8a
org.gradle.jvmargs=-Xmx1280m -XX:MaxMetaspaceSize=384m
org.gradle.parallel=false
org.gradle.workers.max=2
