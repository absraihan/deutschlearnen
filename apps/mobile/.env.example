# Mobile app configuration.
# EXPO_PUBLIC_* variables are bundled into the app, so they MUST NOT contain
# secrets. The AI API keys live only in the server .env.

# Where the server is reachable from your phone.
# On a real device use your computer's LAN IP, not localhost.
# Find it with: ipconfig  (Windows)  /  ifconfig  (macOS, Linux)
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Must match API_TOKEN in the server .env. This is a shared secret for your own
# personal server, not a user credential.
EXPO_PUBLIC_API_TOKEN=

# Override the product name shown in the app.
EXPO_PUBLIC_APP_NAME=DeutschCoach AI
