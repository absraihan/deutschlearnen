# ---------------------------------------------------------------------------
# DeutschLearnen - server environment
#
# Copy to .env (in the repo root, or in apps/server) and fill in.
# NEVER commit .env. The mobile app never sees any of these values: it only
# ever talks to this server, which is the only holder of API keys.
# ---------------------------------------------------------------------------

# --- Branding --------------------------------------------------------------
# Rename the app here, in apps/mobile/app.json, and in DEFAULT_APP_NAME.
APP_NAME=DeutschLearnen

# --- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# 0.0.0.0 makes the server reachable from your phone on the same Wi-Fi.
HOST=0.0.0.0
LOG_LEVEL=info

# --- AI provider -----------------------------------------------------------
# openai | anthropic | gemini | mock
#   mock      = rule-based, offline, free. Start here: the whole app works.
#   openai    = needs OPENAI_API_KEY
#   anthropic = needs ANTHROPIC_API_KEY
AI_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at a compatible gateway instead of api.openai.com
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=

# --- Google Gemini (the only major provider with a free tier) -------------
# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Google retires model aliases periodically; if a request 404s, the API error
# names the current replacement. Set that value here.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=

# --- Speech to text --------------------------------------------------------
# openai-whisper | none
#   none = the phone does recognition on-device (free, needs a dev build)
#   openai-whisper = the phone uploads audio here (more accurate German)
STT_PROVIDER=none
STT_MODEL=whisper-1

# --- Text to speech --------------------------------------------------------
# openai | none
#   none = the phone speaks with its own German voice (free, works in Expo Go)
#   openai = higher quality German voice, costs money per character
TTS_PROVIDER=none
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# Who pays for the AI. true (default): the server answers with its own key,
# which is right for personal use. false: every request must bring the caller's
# own key, so the app can be shared without sharing your quota - the app guides
# the learner through getting one.
ALLOW_SERVER_KEY_FALLBACK=true

# --- Security --------------------------------------------------------------
# Shared secret the app sends as the x-api-token header.
# Leave empty ONLY while everything is on localhost. Set it (any long random
# string) before your phone talks to this server over Wi-Fi, otherwise anyone
# on the network can spend your API budget.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_TOKEN=

# Comma-separated origins, or * for any. The mobile app is not a browser, so *
# is fine here; tighten it if you ever add a web client.
CORS_ORIGIN=*

# --- Limits and cost control ----------------------------------------------
REQUEST_TIMEOUT_MS=45000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
# Refuse a turn whose prompt would exceed this many tokens, as a budget guard.
MAX_PROMPT_TOKENS=6000
